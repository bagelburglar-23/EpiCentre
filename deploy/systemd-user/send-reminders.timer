[Unit]
Description=Run send-reminders three times a day

[Timer]
# 08:30, 16:00, 22:00 HKT (= 00:30, 08:00, 14:00 UTC): a morning nudge, the
# 16:00 gap Lucas actually sees (between Tokyo equities and evening
# derivatives), and a night wind-down. Each fire sends a per-list digest.
OnCalendar=*-*-* 00:30:00
OnCalendar=*-*-* 08:00:00
OnCalendar=*-*-* 14:00:00
Persistent=true

[Install]
WantedBy=timers.target
